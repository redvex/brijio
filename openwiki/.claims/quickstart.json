    {
      "id": "claim_9744f1f4d6a54454bf6aa908ae454ade",
      "statement": "Every request is an explicit request/response chain: the user manually connects the extension (which authenticates with a pairing token and announces presence), the agent calls an MCP tool, the MCP server opens a throwaway WebSocket to the relay authenticating as role mcp and sends one request envelope carrying explicit target browserInstanceId/tabId, the relay selects a connected browser from its presence table and forwards the envelope unchanged, the shared background controller dispatches to the matching adapter threading tabId with an active-tab fallback, and the structured result or error relays back by message id.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts",
          "version": "repo-file-v1:sha256:59770e90cdb08753ea087d409ec6067e35aeeee9c34f20b4a1e18b4a09afa167"
        },
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts",
          "version": "repo-file-v1:sha256:4d8526d5a6f9e384b2878f54096cd833c7c82662fa4270421bbef9e00fcccd4c"
