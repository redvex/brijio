        }
      ]
    },
    {
      "id": "claim_2026d10237744e39b6f16c390d437546",
      "statement": "Client-side action approval (ADR 0048) gates a hardcoded first set of operations — submit_form, fetch_resource, and download_file — behind a browser-side user approval prompt; other actions execute without approval and the model is not approval-on-every-action.",
