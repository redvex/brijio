    {
      "id": "claim_2ab2a33065d74d13baaacc186cb99d8f",
      "statement": "The approval timeout is derived from the local MCP HTTP timeout: approvalTimeoutMs = httpTimeoutMs - approvalTimeoutBufferMs, using BRIJIO_MCP_HTTP_TIMEOUT_MS (default 60000) and BRIJIO_APPROVAL_TIMEOUT_BUFFER_MS (default 5000), yielding a default 55000ms; the default in the background controller is 55000 when not configured, and on timeout the banner is hidden and approval_timeout is returned with the actionUUID.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L157-L191",
          "version": "repo-lines-v1:sha256:880d50a635883ba44c69ff8171d83c0d383818ab566afef86bf049018477fd90:"
