          "version": "repo-lines-v1:sha256:9b6ee67e363948a7832de3cf3ff36f0e0fbfd39986477b7892af93c73c1a5390:"
        }
      ]
    },
    {
      "id": "claim_0493081431264d82a959c6f60d2e3fab",
      "statement": "approve_session grants are scoped to { origin, actionType }. The origin is computed from the active tab URL at approval time and re-verified before execution; if the active tab origin changed, the action fails with approval_origin_changed instead of reusing the grant.",
      "evidence": [
