  "claims": [
    {
      "id": "claim_bc0ddbc5a62249fa9687131e6bafd383",
      "statement": "Client-side action approval is a hardcoded security control gating only submit_form, fetch_resource, and download_file; all other browser actions execute without approval. Policy is evaluated behind a local requiresApproval-style function so it can later move to configurable or enterprise policy without changing the execution pipeline.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L41-L54",
          "version": "repo-lines-v1:sha256:b7db2817f07bc71cc38c7c2d89454407d667d210d5a4c8ed0c492f01a76aac3b:"
        },
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L1696-L1706",
          "version": "repo-lines-v1:sha256:5b17367141470f7cc3ed9cc00c2733227df91cfc8f22247a36d4ddae8b251830:"
        }
      ]
    },
    {
      "id": "claim_f0d2946c921241ec985bd48f3f239fac",
      "statement": "Pending approval actions and approval_session grants are held in extension/background memory only (an in-memory Set) and are not persisted to localStorage, extension storage, or IndexedDB. Grants are cleared when the bridge disconnects, the extension reloads, or the browser session ends.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L46-L52",
          "version": "repo-lines-v1:sha256:f7b76a29964099834a75f59d0630f5e0b74d26c7fae4aac962a9bd5230618410:"
        },
        {
