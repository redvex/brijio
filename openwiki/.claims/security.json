          "version": "repo-lines-v1:sha256:5b17367141470f7cc3ed9cc00c2733227df91cfc8f22247a36d4ddae8b251830:"
        }
      ]
    },
    {
      "id": "claim_57e4076f58744019aa1edbe15a3e6b74",
      "statement": "The MCP server assigns a unique actionUUID and sets approvalRequest true on submit_form, fetch_resource, and download_file request payloads before forwarding them through the relay; for perform_batch only submit_form items carry approvalRequest true.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L76-L137",
          "version": "repo-lines-v1:sha256:a57c64cf49dc3f7ca8bb799793c655ca8195d86917000f7f68b2f2d2f2067773:"
