        }
      ]
    },
    {
      "id": "claim_84f26732e799499faee08bc60f0a1e7a",
      "statement": "Pending approvals time out at approvalTimeoutMs (default 55000 ms) before the local MCP HTTP request timeout, returning a structured approval_timeout error rather than a generic HTTP timeout.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L164-L209",
          "version": "repo-lines-v1:sha256:59e8f899176b7edb991e065ffae1e12c4ad53e3653d5229474e52cccf22475d1:"
