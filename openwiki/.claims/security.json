        {
          "resource": "repo://servers/websocket/src/server.ts#L194-L196",
          "version": "repo-lines-v1:sha256:1fe50435bb31a8d89d92a05d542d1ad07c89573c57e15e631512266cafad89f6:"
        }
      ]
    },
    {
      "id": "claim_7152aa37d5c24bd088ef21756f9ca8c9",
      "statement": "The MCP HTTP server enforces security by requiring Authorization: Bearer <MCP_HTTP_AUTH_TOKEN> on every request (rejecting with 401) and optionally enforcing an origin allowlist via MCP_HTTP_ALLOWED_ORIGINS (rejecting disallowed origins with 403); IP allowlists are explicitly not the security boundary.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/http-server.ts#L173-L183",
