        }
      ]
    },
    {
      "id": "claim_39dd1dc5f7a649fea510f66a67f320f3",
      "statement": "The MCP server and relay authenticate with separate tokens, and the extension authenticates with a pairing token, so agent authorization and browser identity are separate credentials.",
      "evidence": [
        {
          "resource": "repo://docs/security/TRUST_BOUNDARIES.md#L17-L27",
          "version": "repo-lines-v1:sha256:7e982e6f7088b4d7432fc02d14b0acd6cbe87243e0203d673d9c25be930f0202:"
