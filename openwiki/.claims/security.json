  "claims": [
    {
      "id": "claim_ff1e70ea103c418dbc1347cee0936ec6",
      "statement": "Brijio's threat model identifies four attacker classes — malicious agent, compromised relay server, network attacker, and malicious website — with architectural mitigations (explicit request/response, no continuous streaming, user-controlled connection, least-privilege permissions, structured protocol, TLS, future E2E encryption).",
      "evidence": [
        {
          "resource": "repo://docs/security/THREAT_MODEL.md",
          "version": "repo-file-v1:sha256:3834ef41b7cfab6d8f74090137951457198afb0a14be8c7e2f80b629dbc08e4e"
        }
      ]
    },
    {
      "id": "claim_c8a1d91d5a744c5da1a5353ee0731f31",
      "statement": "Trust is placed and minimized across four boundaries (Agent↔MCP Server, MCP Server↔Relay, Relay↔Browser Extension, Browser Extension↔Browser Session), with the MCP/relay using separate authentication tokens from the extension pairing token, and the relay routing messages without inspecting payloads.",
      "evidence": [
        {
          "resource": "repo://docs/security/TRUST_BOUNDARIES.md",
          "version": "repo-file-v1:sha256:9d602d167bc17cbe51fe47ac973dd2dfc7cdacbbad271b23f2ec64df9bf63482"
        }
      ]
    },
    {
      "id": "claim_d30047178caf448b9c68f1d789713484",
      "statement": "Brijio's explicit security guarantees are that it does not export cookies, does not clone browser sessions, is not remote desktop software, does not continuously monitor browsers, does not collect credentials, and the cloud relay is intended as transport rather than a content inspector.",
      "evidence": [
        {
          "resource": "repo://docs/security/SECURITY_GUARANTEES.md",
          "version": "repo-file-v1:sha256:3626a37f667d817cce96ac5aba03bb25c6183302efe00e7bd3aadc3e93b32472"
        }
      ]
    },
    {
      "id": "claim_c603ac2d6d094d048cf806e85c5c509c",
      "statement": "The capability matrix marks cookie export, session cloning, browser mirroring, continuous screenshots, continuous DOM streaming, background surveillance, browser history collection, credential extraction (password fields return browser_error on fill), and MFA interception as intentionally unsupported product boundaries.",
      "evidence": [
        {
          "resource": "repo://docs/project/CAPABILITY_MATRIX.md#L236-L251",
          "version": "repo-lines-v1:sha256:e4abd4d282edac401481512a3e7969866112c9ea5cea5d58bd2bbc88292bbab9:"
        }
      ]
    },
    {
      "id": "claim_fbb89e3b303b420fab6b41abd4e621e3",
      "statement": "AGENTS.md non-negotiable invariants require that the user explicitly starts/stops the bridge, every read or action is explicit (no continuous streaming), approval checks must not be bypassed, and permissions must be kept minimal and documented.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L35-L52",
          "version": "repo-lines-v1:sha256:556c611f368e4d668e5b76098733c128429a7c97b7956076b21a1371b21c7daf:"
        }
      ]
    },
    {
      "id": "claim_773f80d6b6904de981f656bd7ce3b30f",
      "statement": "ADR 0048 (Accepted) adds client-side action approval gating submit_form, fetch_resource, and download_file behind explicit user approve/approve_session/deny decisions in the extension, while other actions do not require approval; the approval-gated list is hardcoded in the first implementation behind a requiresApproval(operation) function.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L30-L55",
          "version": "repo-lines-v1:sha256:08c065b601ae323f1e296f8b17ce04b639c212f7c5fb7c17c9b3416baefabb39:"
        }
      ]
    },
    {
      "id": "claim_00036952b0054415a1e85f6fc5d4df93",
      "statement": "Each approval-gated operation carries a unique actionUUID and approvalRequest: true (every batch item carries an actionUUID), and the user choices are approve (single action), approve_session (grant scoped to {origin, actionType} for the bridge connection), or deny.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L107-L140",
          "version": "repo-lines-v1:sha256:c11b0cc460e100cd2ee125347513899a23ac3fbac963caa3bec649d6969a46ed:"
        }
      ]
    },
    {
      "id": "claim_b7811e2dff554348bce22daadc6036a7",
      "statement": "Approval state (pending actions and session grants) is held in extension/background memory only — not in page localStorage, extension storage, IndexedDB, or other persistent stores — and is cleared on bridge disconnect, extension reload, or session end; before executing an approved action the extension re-verifies the active tab origin and action type, failing with approval_origin_changed if the origin changed.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L141-L155",
          "version": "repo-lines-v1:sha256:351c96368f30983e7570d08393639bb42327e1fd3da5e1f4b5dc5753f57fa00a:"
        },
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L56-L65",
          "version": "repo-lines-v1:sha256:8dc356a3f9d45dcd1d47f62b23ea92f3177abe96171e418f8cdfda1fc494cabe:"
        }
      ]
    },
    {
      "id": "claim_a9284a2f85434cfdac870ecc4c4198b5",
      "statement": "The MCP server is per-invocation and must not hold approval state; continuity lives in the extension and relay, and agent polling for approval status is out of scope (a future WebSocket in-memory status registry keyed by actionUUID would keep MCP stateless).",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L24-L28",
          "version": "repo-lines-v1:sha256:b1aace908937a685ae0b96f39b703185f896471b23065e34096f6ece3afca161:"
        },
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L369-L383",
          "version": "repo-lines-v1:sha256:17181b6cb8722b45fbf80fbafc6dfafe365e8189e724d949a47e9f1d9b588a93:"
        }
      ]
    },
    {
      "id": "claim_a06f6e068ca047e3854daf0b11583466",
      "statement": "Approval-gated requests use an application-level timer computed as approvalTimeoutMs = httpRequestTimeoutMs - approvalTimeoutBufferMs that must fire before the local MCP HTTP timeout; on expiry the extension hides the banner, cancels the pending approval, and returns a structured approval_timeout error.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L157-L210",
          "version": "repo-lines-v1:sha256:79c4831ee8e65d65d4b731b68c7693bcbdaab1d87b6f28ea2b5eeb03579d9da2:"
        }
      ]
    },
    {
      "id": "claim_2856666e39f84c238b3d8d1b5b3d0ad9",
      "statement": "Approval-specific error codes are approval_denied, approval_timeout, approval_unavailable (extension could not render the approval UI), and approval_origin_changed (active tab origin changed before execution), with actionUUID included in the errors.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L346-L355",
          "version": "repo-lines-v1:sha256:1f3d87437d281d902184d60f139e19471a73c39a729030cde3a09456e4063a69:"
        }
      ]
    },
    {
      "id": "claim_97ea0111e4514ac89e5fc67649786900",
      "statement": "Inside perform_batch, each action is treated independently: gated actions prompt one at a time, the batch only advances after the current action succeeds/is denied/times out, denial returns approval_denied for that actionUUID while later actions continue, and an approval timeout returns a partial batch_result with focused errors for timed-out and unexecuted actions while keeping completed results.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L285-L330",
          "version": "repo-lines-v1:sha256:db2a450bacab616dde9c4d0663c59414d00ae617154c939ebb96dd7b9b91eb2d:"
        }
      ]
    },
    {
      "id": "claim_4a870e1847ad4bae9ac0cac5286eefe0",
      "statement": "The background script owns the pending-action queue, approval timeout timers, session approval grants, batch sequencing, and final result assembly, keeping policy state outside the webpage and out of persistent storage.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L331-L344",
          "version": "repo-lines-v1:sha256:d6d4f38984b1806261c87e4645e000aac800378b4f3054db017f677066ba8d33:"
        }
      ]
    },
    {
      "id": "claim_c8150d4f7bc545dfa7003d2753825552",
      "statement": "capture_screenshot (ADR 0064, Proposed) is explicit-only (no auto-capture), active-tab-only via tabs.captureVisibleTab(), returns a viewport JPEG at quality 80 (not full-page, not video), and uses existing *://*/* host permissions plus activeTab with no new permissions; runtime permission errors fall back to capability_not_supported.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0064-visual-action-verification.md#L11-L55",
          "version": "repo-lines-v1:sha256:b7dfdfc4e38f094313fc79f0f5384545182790ef7df06e89bbed7b607d5ee84a:"
        }
      ]
    },
    {
      "id": "claim_dd12c47882404d3598d81724fd7289d9",
      "statement": "capture_screenshot cannot capture background tabs (would require switching focus and disrupt the user); full-page scroll-stitch, annotation, redaction, and screencast/video capture are deferred to a later enterprise tier and are out of scope for the first implementation.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0064-visual-action-verification.md#L201-L230",
          "version": "repo-lines-v1:sha256:b7b9fa27ce917217d3eb4cee9d624490731115669685f5b1abd12204be199df1:"
