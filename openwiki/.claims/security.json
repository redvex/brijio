    {
      "id": "claim_635501fec08e495999c0f90a11baa1be",
      "statement": "fetch_resource enforces a maxSizeBytes limit at both extension and MCP level, a fetch timeout, and a sha256 integrity check so the agent can verify received content matches what the extension fetched; Safari reports cross-origin CORS failures honestly as cors_blocked.",
