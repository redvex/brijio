    {
      "id": "claim_98a3e8c96c794a0192add0c4f711ec67",
      "statement": "Approval-aware batches execute action by action: non-gated actions run normally, gated actions with a matching session grant run, otherwise the banner shows for that action only; a denial returns approval_denied for that actionUUID and the batch continues, while an approval timeout is request-level and returns a partial batch_result with focused timeout/skipped entries for the timed-out and unexecuted actions so the agent can retry them later.",
      "evidence": [
