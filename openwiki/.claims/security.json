    {
      "id": "claim_b45a08c499254d1cb4c34d1ef65e88ef",
      "statement": "fetch_resource is the highest-risk tool: the extension performs fetch(url, {credentials:'include'}) using the browser's live session cookies/auth and streams the response back to the agent over a chunked staging protocol, exfiltrating session-protected content to the agent; ADR 0047 classifies it as high-risk and records it will require explicit per-invocation user approval once approvals ship.",
      "evidence": [
