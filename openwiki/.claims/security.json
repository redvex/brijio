    {
      "id": "claim_8afb77e6355c4a0d92774894037898ca",
      "statement": "download_file and fetch_resource are approval-gated by ADR 0048 along with submit_form: each carries a unique actionUUID and approvalRequest:true, the extension renders an approval banner with approve/approve_session/deny choices, approval state is memory-only and cleared on disconnect, approve_session is scoped to origin+actionType, and origin changes fail the action with approval_origin_changed rather than reusing a grant.",
      "evidence": [
