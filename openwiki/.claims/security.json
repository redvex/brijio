        }
      ]
    },
    {
      "id": "claim_51d281d2598b4d2a923d45931f2f5262",
      "statement": "approve_session grants are scoped to the pair of active-tab origin and actionType, stored in an in-memory Set keyed by origin and actionType, and cleared on bridge disconnect; the origin is re-verified after the user decides and a changed origin fails with approval_origin_changed instead of reusing the grant.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L148-L161",
          "version": "repo-lines-v1:sha256:59d20dd2d0e233bc42e3af254b304eb03e30c80ffc6052625dc6932989b9e19d:"
