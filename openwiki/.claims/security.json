        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L344-L355",
          "version": "repo-lines-v1:sha256:af65edb8ce3114f0de169c5b9c20ce26751c2e14be4e991114724d204d2fe041:"
