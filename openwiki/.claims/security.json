        }
      ]
    },
    {
      "id": "claim_6b84503ae48b46ac8d1dd0a9624c5a93",
      "statement": "Pending actions and approval grants are held in extension background memory only and are never written to page localStorage, extension storage, IndexedDB, or other persistent stores.",
