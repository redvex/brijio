    },
    {
      "id": "claim_a6d605388bb44ae386012ce91feacfff",
      "statement": "AGENTS.md requires an ADR before implementing changes that alter authentication, authorization, privacy, storage, a trust boundary, browser routing/targeting/lifecycle semantics, a product capability, or a cross-package protocol; security design choices must be re-checked against the security docs first.",
      "evidence": [
