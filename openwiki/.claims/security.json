  "claims": [
    {
      "id": "claim_c2fd5825dccf40599010ef79d77261bc",
      "statement": "Brijio's threat model rests on four trust assumptions: the user explicitly starts and controls browser connections, authentication tokens are kept secret by authorized parties, the browser session belongs to the user, and the relay transports messages without requiring content inspection.",
      "evidence": [
        {
          "resource": "repo://docs/security/THREAT_MODEL.md#L58-L63",
          "version": "repo-lines-v1:sha256:f631d289d658d40bca434b52ed9ebf9309f2fba350ff5bc3b1f30ff4c54bab9a:"
        }
      ]
    },
    {
      "id": "claim_24470de27c7e4b42979fbd8706959254",
      "statement": "The security docs define Brijio's goals as protecting browser sessions, avoiding credential exposure, minimizing unnecessary data transfer, reducing trust in relay infrastructure, and maintaining user control.",
      "evidence": [
        {
          "resource": "repo://docs/security/THREAT_MODEL.md#L9-L13",
          "version": "repo-lines-v1:sha256:ecf26a737390c8780bb098b582ff9b5c8b8f40ab8f35d566cb3e830608833480:"
        }
      ]
    },
    {
      "id": "claim_f22243e4a4b44e1baba01140211c74d1",
      "statement": "The threat model names four attacker classes — malicious agent, compromised relay server, network attacker, and malicious website — each with architectural mitigations rather than purely defensive code patterns.",
      "evidence": [
        {
          "resource": "repo://docs/security/THREAT_MODEL.md#L15-L57",
          "version": "repo-lines-v1:sha256:d30cb2ebd88254777583c69bfd36cef7638f1e59523257b7d98b629ff5a823da:"
        }
      ]
    },
    {
      "id": "claim_a49d8cb1587b48c6a7d1f403616b7f71",
      "statement": "Extension keepalive messages are sent every 20 seconds and contain only an extension_keepalive payload with no browser state, so no background data transmission occurs while connected.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L1623-L1634",
          "version": "repo-lines-v1:sha256:28d0565d83dc3d6237da07b875bc222a032c2964cd6a1644f062ffa2cf427d6e:"
        }
      ]
    },
    {
      "id": "claim_869422ce82fe47768c8687e7073b9344",
      "statement": "Client-side action approval is required for exactly three operations — submit_form, fetch_resource, and download_file — as determined by getApprovalActionType, which recognizes only those three action types; all other actions pass through without approval.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L42-L47",
          "version": "repo-lines-v1:sha256:f1d4a0ad98ef172b63e1d9e6cd1466b9499ca4e14af088347a60da3f517b79f7:"
