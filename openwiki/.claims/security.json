        }
      ]
    },
    {
      "id": "claim_b2072323cb8145ebbfae9e8f3911bc27",
      "statement": "Security vulnerability reporting is private (do not disclose publicly); reports are sent to a private address and the scope covers browser extensions, WebSocket servers, MCP servers, authentication mechanisms, and encryption implementations.",
