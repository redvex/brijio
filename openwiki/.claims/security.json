    {
      "id": "claim_c2fd2baa961b4c02b5a87fbf74894e88",
      "statement": "download_file privacy boundaries enforce basename-only filenames with no directory paths, deliver metadata (not file contents) to the agent, use a session-scoped registry with no historical access, and explicitly exclude the downloads.open permission so the agent cannot open files.",
