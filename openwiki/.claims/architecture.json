        }
      ]
    },
    {
      "id": "claim_b87b66083d604395b52495feb27b0d19",
      "statement": "The WebSocket relay authenticates clients by pairing token, scopes presence by token-derived scope key, answers list_browsers directly from its in-memory presence map, and forwards all other MCP requests to the selected browser while registering pending request IDs so extension responses route back to the originating MCP socket; it holds no page content.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L326-L430",
          "version": "repo-lines-v1:sha256:e83a18be1fe0a984fbe9f7cfcbf70cf3eaa084b9de2dcb13724e53c8dd5f208d:"
