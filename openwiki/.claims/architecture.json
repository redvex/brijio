        }
      ]
    },
    {
      "id": "claim_c5d3fb41d0eb47e9986a3c8fec67b8c1",
      "statement": "Brijio uses stateless, per-call targeting rather than hidden session state: list_browsers targets a connected extension via browserInstanceId, list_tabs targets a tab via tabId, and the envelope target carries browserInstanceId and tabId. When tabId is omitted, the system falls back to the active tab.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L30-L45",
