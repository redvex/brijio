    {
      "id": "claim_5394d0fabf614deb8005385ba251f49a",
      "statement": "The request flow is: user starts the bridge; the extension authenticates with a pairing token and announces presence; the agent calls an MCP tool; the MCP server authenticates and sends a WebSocketEnvelope with an optional target to the relay; the relay resolves and forwards to the browser socket; the extension's controller dispatches to the appropriate adapter; the response is routed back to the pending MCP socket and returned as a structured ToolResult.",
      "evidence": [
        {
