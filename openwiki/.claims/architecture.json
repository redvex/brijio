    {
      "id": "claim_851e73815f0a4ed6813c5196cbf5a7b6",
      "statement": "The relay answers list_browsers directly from its scoped presence table; for other MCP requests it selects a browser by explicit browserInstanceId, auto-routes when exactly one browser is online, returns browser_unavailable when none are online, and returns ambiguous_browser_target (listing candidates) when more than one is online and no ID is given. list_tabs is forwarded to the extension rather than answered by the relay.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L332-L391",
