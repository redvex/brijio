    {
      "id": "claim_75819bfb9d004cdebab624cfc50116e9",
      "statement": "The MCP server is the agent-facing API surface: it exposes MCP tools, resources, and skills, translates agent calls into protocol envelopes, forwards them to the relay, and returns structured results. The HTTP/MCP runtime is assembled in servers/mcp/src/http-server.ts and tool/resource registrations live in servers/mcp/src/mcp-server.ts; the entrypoint servers/mcp/src/index.ts reads env options and starts the server.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/http-server.ts#L59-L115",
          "version": "repo-lines-v1:sha256:f8e2b7e47d8d3c46984eafd09a9a1cdb49aa3b67c432c0125e161b1ee3282320:"
