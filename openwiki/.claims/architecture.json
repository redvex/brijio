    {
      "id": "claim_2223e29c9c09407ab6bde3dd260d024a",
      "statement": "The WebSocket relay is the local transport and routing layer: it authenticates clients with the local pairing token, tracks runtime-only browser presence in memory, and routes messages between the MCP server and connected browser extensions. Presence disappears when the socket closes. The entrypoint servers/websocket/src/index.ts reads WEBSOCKET_HOST/WEBSOCKET_PORT and starts the server assembled in servers/websocket/src/server.ts.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/index.ts",
          "version": "repo-file-v1:sha256:e0f6605a7e1def495322c60b48db3217cea305f32ac47b42db2662db837a1240"
