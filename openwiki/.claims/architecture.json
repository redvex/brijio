    },
    {
      "id": "claim_5de4b901521141a981b6690586f64928",
      "statement": "The relay keeps browser presence in an in-memory Map keyed by scopeKey:browserInstanceId; extension presence is announced after auth and on server request, removed on disconnect. MCP requests with an id are stored as pending (scopeKey:requestId -> mcpSocket) and forwarded to the selected extension; the extension's matching-id response is routed back to the waiting MCP socket and the pending entry deleted.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L129-L139",
          "version": "repo-lines-v1:sha256:0f56a4810c42c1612ab103df682170991b89638b520526f0e972b77fbd90b899:"
