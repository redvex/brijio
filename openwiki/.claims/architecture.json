    {
      "id": "claim_558eabfe16b640968c34a6bf70263476",
      "statement": "The WebSocket relay authenticates MCP and extension connections with a high-entropy pairing token; it derives a SHA-256 scopeKey from the token so the raw token is never exposed in logs/responses/presence, and all presence and pending-request keys are scoped by scopeKey so different tokens never see each other's browsers or requests.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0021-local-pairing-presence-routing.md#L26-L43",
          "version": "repo-lines-v1:sha256:08049cda7c5981713efc979bce178d73d66c4ba8fa893b92838bb47ca98c78d9:"
        },
