    {
      "id": "claim_d9299fa8866440b4a74b8bd6a4eb141f",
      "statement": "Chrome and Safari extensions are thin browser-specific adapters around the shared logic: they connect only after explicit user action, authenticate to the relay with the pairing token, announce browser presence, and answer explicit per-call requests. They are reactive and do not publish ambient browser state.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L52-L57",
