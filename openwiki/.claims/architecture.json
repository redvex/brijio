    {
      "id": "claim_f9a494c92fbd4f0281f060e66b56b189",
      "statement": "The WebSocket relay authenticates mcp and extension roles against the pairing token set, derives an internal scopeKey from the token, namespaces presence and routing by that scope key (raw tokens never appear in logs or responses), keeps presence only in an in-memory Map keyed by scopeKey:browserInstanceId that disappears on socket close, and routes responses back to the waiting MCP socket by scopeKey:requestId.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0021-local-pairing-presence-routing.md#L25-L92",
          "version": "repo-lines-v1:sha256:4cdf71edba4139f32f822d98c0e4fc3d2227c65fa765e5e62e8d5d2cc29f6049:"
