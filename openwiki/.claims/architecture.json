    {
      "id": "claim_a7348dd668b546b6b01d100f80f4ffcc",
      "statement": "The connection sequence is: the extension authenticates with role=extension and the pairing token, receives auth_success, answers a browser_presence_request with browser_presence_announce carrying capabilities; the MCP server authenticates with the same token under role=mcp before sending request envelopes that the relay forwards to the target browser instance.",
      "evidence": [
        {
          "resource": "repo://README.md#L120-L160",
          "version": "repo-lines-v1:sha256:4e02e3db311f22f4aecaa37f8f10c4b95bfa3fe3ff4487ab618cdcc9d3447ca6:"
