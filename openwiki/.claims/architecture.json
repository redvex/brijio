    {
      "id": "claim_d80188e4fdc64f0fa675808b557c1b9e",
      "statement": "Brijio runtime is a single explicit chain: Agent -> MCP Server -> WebSocket Relay -> Browser Extension -> Browser Session, and the browser remains the source of truth with no cloning or continuous streaming.",
