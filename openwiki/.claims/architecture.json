  "claims": [
    {
      "id": "claim_3ac01ec925dc43179c0e7850206e0c7f",
      "statement": "Brijio's runtime is an explicit request/response chain Agent -> MCP Server -> WebSocket Server -> Browser Extension -> Browser Session, in which the browser is the source of truth and is never cloned or continuously streamed.",
      "evidence": [
        {
          "resource": "repo://README.md#L86-L113",
          "version": "repo-lines-v1:sha256:2b94218c130bd1fdb104d564a3842a92802af2305c8fd8d40c00f5d555a3bbb4:"
        },
        {
          "resource": "repo://docs/architecture/ARCHITECTURE.md#L1-L24",
          "version": "repo-lines-v1:sha256:d8ff03002f9e787317ac0945abf32ee281bba957d3dc080606709fa1b074779a:"
        }
      ]
    },
    {
      "id": "claim_8ddf934c26d04d00b86d6498671216bb",
      "statement": "The extension is reactive: it connects only after explicit user action, authenticates with a pairing token, announces browser presence, and answers discrete requests rather than streaming page state, screenshots, DOM updates, or history.",
      "evidence": [
        {
          "resource": "repo://README.md#L145-L191",
          "version": "repo-lines-v1:sha256:05e51b0ffbb8c42c5ba0469021de7d128f0f768e2c178a999616d9b11723b6e0:"
