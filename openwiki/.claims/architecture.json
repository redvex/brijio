  "claims": [
    {
      "id": "claim_9f0d9891816443519d8207467a4fef5a",
      "statement": "Brijio's runtime is an explicit request/response chain Agent -> MCP HTTP server -> WebSocket relay -> browser extension -> browser session; the browser is the source of truth and agents never receive a cloned browser or continuous stream.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L38-L59",
          "version": "repo-lines-v1:sha256:5108fa23a0704a925607058fa4efeac64680aab8e7afcdbb38cc529e2b919c32:"
        },
        {
