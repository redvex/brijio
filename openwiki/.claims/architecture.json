    },
    {
      "id": "claim_8f99ae9460ff441e95b181383ee2f0c4",
      "statement": "The shared package packages/shared owns the canonical protocol and browser-agnostic logic; packages/shared/src/protocol.ts defines the WebSocketEnvelope, BrijioRole, AuthPayload, BrowserPresence, BrowserCapability, and tab-listing types used by every other component, and index.ts re-exports the shared modules.",
      "evidence": [
        {
