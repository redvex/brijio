    {
      "id": "claim_02562bc9076c4d389617767125022261",
      "statement": "A connection authenticates with an AuthPayload (type 'auth', role 'extension'|'mcp', token). The relay checks the token against the configured pairing-token set, derives a scopeKey via SHA-256, replies with AuthSuccessPayload, and keys presence records and pending requests by scopeKey so different pairing tokens never see each other's browsers.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/protocol.ts#L44-L52",
          "version": "repo-lines-v1:sha256:78e035c3ed0ce45b1140486cc01d4a4683ceafa73687ff774d75110177072c10:"
