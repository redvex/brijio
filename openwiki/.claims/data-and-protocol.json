    {
      "id": "claim_f5868d5a0cd64f9fae157ba3eebae85f",
      "statement": "Every normal wire message is wrapped in a WebSocketEnvelope with type 'message', an optional string id (correlation id echoed on responses), an optional target carrying browserInstanceId and tabId routing, and an untyped payload; a distinct type 'error' is reserved for the router-level BrijioErrorEnvelope.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/protocol.ts#L1-L7",
          "version": "repo-lines-v1:sha256:afd38d3fa9cef48187dadd86012af68a3ae5644cc7e12e92896874aef1be1dad:"
        },
        {
