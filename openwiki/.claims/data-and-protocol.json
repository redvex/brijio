    {
      "id": "claim_044c4d20c658414089036a1348a08498",
      "statement": "Tab targeting is explicit and per-call: a tool call passes tabId in envelope.target.tabId and the extension falls back to the active foreground tab when tabId is absent; there is no hidden session-level selected-tab state, mirroring how browserInstanceId works. TabInfo exposes opaque raw tabId/windowId strings, title, url, active, and supported, with list_tabs/tab_list_response request/response payloads.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L28-L41",
