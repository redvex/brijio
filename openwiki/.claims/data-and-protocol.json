    {
      "id": "claim_fe07022034e649d485b91f0dfbf2622c",
      "statement": "A page is exposed through two distinct surfaces: PageContext is the structured a11y/interactive snapshot (url, title, structure of headings/landmarks/links/images/forms/editables/actions, a truncated preview, and a content fetch descriptor), while PageContent is one byte-bounded chunk of readable Markdown fetched on demand via get_page_content with a 1-based index and chunked by page-content.ts (defaultPageContentMaxPayloadBytes = 131072, splitContent splits on blank-line block boundaries then falls back to character splitting, chunkReadableContent throws invalid_index for out-of-range indices).",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/page-content.ts#L32-L117",
          "version": "repo-lines-v1:sha256:4885899d4c434532460c888269a5fe9f76b12d15b6b659ad5368dc4bdfc6eee4:"
