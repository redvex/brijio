    {
      "id": "claim_44e605c8742848e1816faa559c5f4d25",
      "statement": "BrowserCapability is a closed union of named feature flags (page_context, page_content, click, fill_input, fill_editable, set_checked, select_options, submit_form, navigate, batch, upload_file, download_status, download_file, fetch_resource, screenshot); isBrowserCapability validates a single flag and presence announce validation requires every advertised capability to pass it.",
