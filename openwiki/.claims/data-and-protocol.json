    {
      "id": "claim_fe57636f6785405d8eac463a0c3876d0",
      "statement": "For the first implementation only submit_form, fetch_resource, and download_file require approval; the approval-gated list is hardcoded, approval state is in-memory only, and approve_session grants are scoped to { origin, actionType } and cleared when the bridge disconnects, the extension reloads, or the browser session ends.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L31-L60",
          "version": "repo-lines-v1:sha256:eccab7a7c7d37c412580e21f03116abdc74d8d46a6ac8253ebb8bf85a3fe95a4:"
        }
      ]
    },
    {
      "id": "claim_5f7d77125b994e77a4fa0ceb6d1acd8c",
      "statement": "The MCP server assigns a unique actionUUID via createActionUUID (action-<ts>-<rand>), marks approval-gated actions with approvalRequest true, and for perform_batch attaches a unique actionUUID to every batch action while setting approvalRequest true only on submit_form items; the envelope id remains the request/response correlation identifier while actionUUID identifies the specific action within the request or batch.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L76-L138",
          "version": "repo-lines-v1:sha256:2ffa92c67cec68f91f4f4139b10a3004a43455eac6d1c3eec1e7fd7abf8ae3c9:"
