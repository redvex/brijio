    {
      "id": "claim_f695d9d1f9de428fa0e0ade4a42f843a",
      "statement": "Browser presence is discovered on demand via BrowserPresenceRequestPayload and announced via BrowserPresenceAnnouncePayload, which extends BrowserPresence with browserInstanceId, label, browserName, profileName, optional connectedAt/lastSeenAt, and a capabilities array; browserInstanceId is the routing key reused in envelope.target for all per-browser calls.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/protocol.ts#L1138-L1161",
