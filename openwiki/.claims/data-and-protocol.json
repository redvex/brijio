    {
      "id": "claim_230ae2bda22b4f969ce39f2ec0481382",
      "statement": "Every WebSocket message is wrapped in a WebSocketEnvelope (aliased BrijioEnvelope) with type 'message', optional id for request/response correlation, and an optional target carrying browserInstanceId and tabId for per-call routing; the relay forwards the envelope unchanged and does not interpret the payload beyond routing.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/protocol.ts#L1-L9",
          "version": "repo-lines-v1:sha256:c9fb1e4cd894affcdecc4553117783ac2c2770cc4460941a1bd42260086a4201:"
