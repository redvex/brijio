    {
      "id": "claim_83a2495922714627987e020f6e680d7b",
      "statement": "DownloadStatusResponse carries a capability of 'full' or 'not_supported' plus items that are DownloadInfo (kind 'download', numeric id) or FetchResourceInfo (kind 'fetch', string id), each with a DownloadState of in_progress/complete/interrupted (fetch adds 'streaming'); download_file and fetch_resource requests extend ApprovalMetadata and target a browser via target.browserInstanceId.",
      "evidence": [
