    {
      "id": "claim_410679dc450d43079ceba893ace40418",
      "statement": "Tab listing is an explicit on-demand request: ListTabsRequestPayload (type 'list_tabs') returns a TabListResponsePayload/TabListErrorResponsePayload that share payload type 'tab_list_response' distinguished by ok. TabInfo carries opaque tabId/windowId (raw Chrome/Safari ids as strings), title, HTTP/HTTPS url, active, and supported flags; only regular HTTP/HTTPS tabs are listed.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L48-L82",
