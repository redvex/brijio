    {
      "id": "claim_9c28926af13b41249e4fbe63d0d6c152",
      "statement": "Staged file uploads use a chunked protocol keyed by uploadId: StageFileUploadStartPayload (file metadata, chunkSize, totalChunks), repeated StageFileUploadChunkPayload (index, dataBase64), StageFileUploadCompletePayload (optional sha256), a StageFileUploadStagedPayload confirmation, a StageFileUploadAckPayload ack, and a StageFileUploadErrorPayload with codes invalid_file_payload, checksum_mismatch, file_too_large, invalid_file_name, invalid_file_type, or upload_expired.",
      "evidence": [
