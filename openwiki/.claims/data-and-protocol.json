        }
      ]
    },
    {
      "id": "claim_6ad22fc2dfd04334882260d42c475268",
      "statement": "Connections authenticate with BrijioRole 'extension' or 'mcp'; AuthPayload carries the role and token and AuthSuccessPayload acknowledges the connection, with createAuthEnvelope and isAuthPayload implementing the handshake.",
