    {
      "id": "claim_b1ad03fbfb8b4e26877b096aa4d0511a",
      "statement": "perform_batch executes up to BATCH_MAX_ACTIONS = 20 actions sequentially with a BatchResultResponse carrying one entry per action: continueOnError (default false) aborts remaining actions on any element-level error while true records and continues; page navigation always aborts (the runner compares locationHref to its pre-batch value after each action and marks remaining actions aborted:true with page_navigated, overriding continueOnError); readAfterActions appends a fresh PageContext as the final entry.",
      "evidence": [
