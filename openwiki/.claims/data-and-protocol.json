    {
      "id": "claim_bd0cd96b3ab54193a034095bb7a56b59",
      "statement": "Inside a perform_batch the extension treats each action independently: non-approval actions execute normally, approval-gated actions with a matching session grant execute, and those without a grant prompt one approval banner at a time; a denied action returns approval_denied for its actionUUID without aborting the batch, while an action that navigates the page still aborts remaining actions because prior page IDs may be invalid.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L280-L355",
          "version": "repo-lines-v1:sha256:00ec43db3a288475ff2493986645b25af776a55df7a57e7ff52c1c9c61b6450a:"
        }
