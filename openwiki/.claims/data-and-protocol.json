    {
      "id": "claim_3eb90c8443d34f438623004d20c36e54",
      "statement": "Approval validation is enforced in the protocol guards: hasValidApprovalMetadata rejects a non-string or blank actionUUID and a non-boolean approvalRequest, and isPerformActionEnvelope and isBatchAction require it to pass before accepting an action payload.",
