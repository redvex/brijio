    {
      "id": "claim_7bc94b77ee614d60948b9bd54475bade",
      "statement": "Staged file upload is a multi-message handshake scoped by uploadId: stage_file_upload_start (file metadata, chunkSize, totalChunks), stage_file_upload_chunk (index, dataBase64), stage_file_upload_complete (optional sha256), then stage_file_upload_staged ack from the extension and stage_file_upload_ack from the caller; errors use a closed code set (invalid_file_payload, checksum_mismatch, file_too_large, invalid_file_name, invalid_file_type, upload_expired).",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/protocol.ts#L77-L148",
          "version": "repo-lines-v1:sha256:6986b86d31e832dcde61780695944500f0bb69c6fd2c91c001c14fd9e00a77cd:"
        }
