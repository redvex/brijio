    {
      "id": "claim_7b2ff8260687448a81f5cd7dc6400e66",
      "statement": "The three user decisions are approve (one-time, no grant stored), approve_session (session-scoped grant keyed by origin\\u0000actionType for the current bridge connection), and deny (approval_denied error with actionUUID); timeout is an extension-owned timer outcome returning approval_timeout, and approval_unavailable and approval_origin_changed are returned when the UI/origin cannot be established or the active origin changed before execution.",
      "evidence": [
