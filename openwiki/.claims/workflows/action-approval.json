    {
      "id": "claim_9201914e089d4bfba815d8568df29be4",
      "statement": "The approval timeout is an application-level timer derived from the local MCP HTTP timeout as approvalTimeoutMs = httpTimeoutMs - approvalTimeoutBufferMs (defaults BRIJIO_MCP_HTTP_TIMEOUT_MS=60000 and BRIJIO_APPROVAL_TIMEOUT_BUFFER_MS=5000, clamped to a 1000 minimum, yielding 55000), threaded into the WebSocket client and background controller so it fires before the HTTP layer returns a generic timeout.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L119-L148",
