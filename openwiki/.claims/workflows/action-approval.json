    {
      "id": "claim_15150401611e4955ae576e4de107056f",
      "statement": "When a perform_batch contains any approval-gated action, BrijioBackgroundController routes the whole request through performApprovalAwareBatch, which sequences actions in the background, prompts per action, treats denial as a focused per-action approval_denied that continues later actions, and on approval timeout records approval_timeout for the current action plus skipped approval_timeout entries for remaining actions so already-completed results are preserved and remaining actions remain retryable.",
      "evidence": [
