    {
      "id": "claim_7ec5b216d7fe44a98adcf4dfc3a6c1c8",
      "statement": "ensureApprovedAction is the single gate every approval-gated path funnels through (perform_action, download_file, fetch_resource, and approval-aware perform_batch). It requires both getApprovalActionType(type) and approvalRequest===true, then fails closed on missing actionUUID, missing adapter, or missing active origin, reuses a session grant, prompts with a timeout, and re-checks the active origin after approval returning approval_origin_changed if it changed.",
      "evidence": [
