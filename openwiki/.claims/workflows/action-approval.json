    {
      "id": "claim_475fe420223a4391829f7150a80a335a",
      "statement": "Only submit_form, fetch_resource, and download_file require client-side approval in the first implementation; the gated set is hardcoded and all other action types (click, write_text/fill_input/fill_editable, set_checked, select_options, upload_file, and non-gated perform_batch steps) execute without an approval prompt.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0048-client-side-action-approval.md#L41-L48",
          "version": "repo-lines-v1:sha256:4f115d6d983595cf88a546757ff0ffdc61709251adea2d0e1e9ea4871f154a01:"
        },
