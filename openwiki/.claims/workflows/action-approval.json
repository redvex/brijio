    {
      "id": "claim_9d2bc28fbeda405b8514dd118e0cfa8d",
      "statement": "The approval timeout is derived from the local MCP HTTP timeout minus a safety buffer (approvalTimeoutMs = max(1000, httpRequestTimeoutMs - approvalTimeoutBufferMs), defaults 60000 and 5000 yielding 55000) and must fire before the HTTP request timeout so a structured approval_timeout is returned instead of a generic HTTP timeout.",
      "evidence": [
