    {
      "id": "claim_62ebbafd7a3143eab58f62a0baa2f360",
      "statement": "BrijioBackgroundController.ensureApprovedAction is the single approval gate: it returns ok immediately for non-gated actions, fails closed with approval_unavailable when actionUUID/approval adapter/active origin is missing, reuses an in-memory session grant, races requestApproval against an approval timer, and returns approval_timeout or approval_denied accordingly, then re-checks the active origin before executing and stores an approve_session grant only if the origin is unchanged.",
      "evidence": [
