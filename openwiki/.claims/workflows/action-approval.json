    {
      "id": "claim_998af8f0912b429f9153198cb2493c2d",
      "statement": "Approval state (session grants and pending prompts) is held only in background-controller memory (the approvalSessionGrants Set) and the DOM banner; it is never written to localStorage, IndexedDB, extension storage, or other persistent stores, and grants are cleared when the bridge disconnects (disconnect calls approvalSessionGrants.clear).",
      "evidence": [
