    {
      "id": "claim_6aaf85ab442441e09cf3f46317d321aa",
      "statement": "The approval timeout is derived from the local MCP HTTP request timeout minus a buffer (approvalTimeoutMs = max(1000, httpTimeoutMs - approvalTimeoutBufferMs), defaults 60000 and 5000 yielding 55000) so the structured approval_timeout error returns before the HTTP server or client produces a generic timeout; the background controller falls back to 55000 when no timeout is supplied.",
      "evidence": [
