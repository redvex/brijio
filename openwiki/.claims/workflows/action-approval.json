    {
      "id": "claim_50927f5ca9eb42c789a38b17cf456a51",
      "statement": "The background controller depends on an ApprovalAdapter interface (getActiveOrigin, requestApproval, hideApproval) and an ApprovalDecision union of 'approve' | 'approve_session' | 'deny'; ApprovalRequest carries actionUUID, actionType, origin, and timeoutMs. ApprovalActionType is the same hardcoded union of the three gated types.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L258-L276",
          "version": "repo-lines-v1:sha256:7d151d0233fa33112dcb7ca14fdba3a85debebda378a07018503aafd079d29cd:"
        }
      ]
