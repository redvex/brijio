    {
      "id": "claim_68095026a1d146178e53e618a665ca72",
      "statement": "open_tab is used to work on a second page without disrupting the current tab — the gap that neither navigate_to_url (which overwrites the current tab's state) nor fetch_resource (raw HTML, no rendering or session) fills. Chrome and Safari both implement the same PageOpenTabAdapter using the standard tabs.create({ url }) WebExtensions API. The new tab may not be the active foreground tab, so the agent must pass the returned tabId to subsequent calls.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0063-open-tab-action.md#L11-L30",
          "version": "repo-lines-v1:sha256:c690cc97c1ba6e0ecdf107912cf91e2ab74b3c3f9e59997e281d59edf8ae2b78:"
