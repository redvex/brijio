    {
      "id": "claim_8c44dfec980f42bcbba34abd4ce7b99c",
      "statement": "tabId rides on the existing target field of the WebSocket envelope alongside browserInstanceId. The MCP websocket-client only adds a target object when at least one of browserInstanceId or tabId is defined, so requests with neither remain unchanged and hit the active tab. On the extension side, BrijioBackgroundController.extractTabId reads message.target.tabId, parses it to a safe integer, and returns undefined when absent; that undefined is the active-tab fallback signal passed to reader/action/batch/navigation handlers.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L227-L241",
          "version": "repo-lines-v1:sha256:db393c6e68ec4b85086747ba764e8b1db06a517d8a7cdaece8689b1b6687e810:"
