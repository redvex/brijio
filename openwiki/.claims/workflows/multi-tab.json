    {
      "id": "claim_1f8d4a8e317b4895b8d333a7d36c18af",
      "statement": "When the shared page reader acts on a tab it best-effort sends `show_brijio_tab_indicator` to that tab's content script, which prepends `● ` to `document.title` (re-applied via a MutationObserver when the page changes its own title), injects a persistent blue 'Brijio is active on this tab' banner, and auto-hides the whole indicator after 60 seconds of inactivity, restoring the original title — making background-tab targeting visible to the user.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/content-script-entry.ts#L181-L325",
          "version": "repo-lines-v1:sha256:f2ac6a296edbf8f3ce3e8c04fb4d5b2e421a30f82c9254516897d908492633e1:"
        },
        {
