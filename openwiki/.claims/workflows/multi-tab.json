    {
      "id": "claim_e4732f5a1a2b40e2b9f2f3979a807b76",
      "statement": "capture_screenshot (ADR 0064) is active-tab-only by design because it is built on the browser captureVisibleTab API (chrome.tabs.captureVisibleTab / browser.tabs.captureVisibleTab) which can only capture the visible tab in a window. Although the tool accepts a tabId in its input schema and threads it into requestCaptureScreenshot, the extension adapter pageScreenshot.captureScreenshot() takes no argument and captures the active tab regardless. Capturing a background tab would require switching focus, which is user-disruptive.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/background.ts#L498-L560",
          "version": "repo-lines-v1:sha256:b0cb94314cfc49ca34adb84bc62295bc0402a1d4a87af94de8d450ee140da995:"
