    {
      "id": "claim_52bf5b6108e845f5a7a0c271faa774be",
      "statement": "list_tabs is an on-demand tool that returns only HTTP/HTTPS tabs (isRegularPageUrl excludes chrome://, chrome-extension://, about:, file:, safari://; incognito tabs are excluded). It is browser-scoped, not tab-scoped, and the extension queries all tabs via tabs.query({}) then filters. Safari private mode may return an empty list, but the agent can still target the active tab by omitting tabId.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/background.ts#L371-L396",
          "version": "repo-lines-v1:sha256:d4d0931b601f1dbb9a679213f6cd0b4d59735d9ff4dd2b39853764c43c377503:"
