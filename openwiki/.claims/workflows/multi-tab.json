    {
      "id": "claim_6d7491bac77d45c1abaee1580b3da63e",
      "statement": "`open_tab` and `list_tabs` return a `not_supported` error when the connected extension does not provide the `pageOpenTab` or `tabLister` adapter; adapter throws during tab creation are wrapped in `open_tab_failed` responses by the controller.",
