    {
      "id": "claim_73c073d1e53f47f1bc43702d7c67bd49",
      "statement": "Editing guidance invariant: any tool touching page state should accept and forward tabId through the full stack (tool wrapper normalizeInput, page-actions/page-context helper, WebSocket request options, background-controller handler) — not just the Zod schema. Schema, the using-brijio and navigation skills, and forwarding must move together; a schema-level tabId that is not forwarded is a silent no-op. Tab lifecycle races are expected (a tab can close between list_tabs and a tabId-targeted action) and must surface a clear no_active_tab or tab_not_found error.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L322-L335",
          "version": "repo-lines-v1:sha256:3074a9044c612225f9808d98f622f3afcc2f1094a87c20b4bc52acb4e292fd36:"
        },
