          "version": "repo-lines-v1:sha256:d72bb3c0b29f9a78da408587364ff544987e9cdd602bf7bf3128f7d8ba6f5044:"
        }
      ]
    },
    {
      "id": "claim_709fd39dd5f04f4ab7efc0fe3556da44",
      "statement": "`open_tab` opens a new tab at an HTTP(S) URL via `PageOpenTabAdapter.openTab` (`chrome.tabs.create`/`browser.tabs.create`), returns the new `{ tabId, url, title }`, does not wait for the page to load, and has no `close_tab`/ownership tracking (deferred to P2.5). When the adapter is absent the controller reports `not_supported`. Both Chrome and Safari implement the same adapter with full parity.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0063-open-tab-action.md#L1-L45",
          "version": "repo-lines-v1:sha256:487c5aa42a6102fee6174c62cf21287e5520ed5c362eaa5e686c3b4a3673aace:"
        },
        {
