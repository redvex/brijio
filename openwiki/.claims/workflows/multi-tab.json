          "version": "repo-lines-v1:sha256:1e6f87e087989712fb73ea4f411d89f3af7c23eba1ff477fa4cf92e71e19f46d:"
        }
      ]
    },
    {
      "id": "claim_0b2602fa67fc42ebb1affd73b2e1ae78",
      "statement": "The `list_tabs` MCP tool asks the connected extension for all open tabs; both Chrome and Safari adapters implement the shared `TabListerAdapter` by querying all tabs (`tabs.query({})`) and filtering to regular HTTP/HTTPS pages via `isRegularPageUrl()`, excluding tabs without an id or URL, and returning TabInfo entries with a string `tabId`.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/background.ts#L371-L394",
          "version": "repo-lines-v1:sha256:756b8148f7199b65549a7f35b6afc8473b1b7a5c11d89bb530e5a9e8421a7326:"
        },
        {
