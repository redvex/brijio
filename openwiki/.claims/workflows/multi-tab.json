    {
      "id": "claim_932514bdd37d4008a2d1455e715e3dd0",
      "statement": "Every browser-interfacing MCP tool registers an optional `tabId` string input (the shared `tabIdInput = z.string().optional()`) in `mcp-server.ts`; when `tabId` is omitted the extension falls back to the active foreground tab, and when present it targets that specific tab (including background tabs). `open_tab` is the exception: its input schema is `url` + `browserInstanceId` only, because it creates a new tab and returns one.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L88-L120",
          "version": "repo-lines-v1:sha256:2b3eb727dcac55d04fa882edfec4f357a875d08759a64ece057b16d5046c3504:"
        },
        {
