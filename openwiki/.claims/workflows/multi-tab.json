    {
      "id": "claim_d4ed16ab689f46e2b72424d42f496d9a",
      "statement": "open_tab (ADR 0063) opens a new browser tab at an HTTP/HTTPS URL and returns the new tab's tabId for immediate targeting. Its input is url plus optional browserInstanceId only (no tabId input — it produces one). Only http/https schemes are allowed via the same parseUrl/unsupportedSchemeResponse validation as navigate_to_url; other schemes return unsupported_scheme. It returns { tabId, url, title } where title may be empty until load, does not wait for the page to load, and has no close_tab or tab ownership tracking.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0063-open-tab-action.md#L33-L48",
          "version": "repo-lines-v1:sha256:c0bbb4896c77b578273143c7943d28c768bb724dd0a172ca7f91c7e0dba6ff93:"
