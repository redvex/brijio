    {
      "id": "claim_7069b381d16b41d5b208191c2cb5083a",
      "statement": "Every tab-aware MCP tool (read_current_page, click_element, fill_input, fill_editable, set_checked, select_options, submit_form, perform_batch, navigate_to_url, list_tabs, capture_screenshot) accepts an optional string tabId via a shared tabIdInput Zod schema. When tabId is omitted, the system falls back to the active foreground tab: extractTabId returns undefined and the extension adapters operate on the active tab via tabs.query({active:true, currentWindow:true}).",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L1788-L1800",
          "version": "repo-lines-v1:sha256:e8f947d829c49a1b0a47927bca2b4051dba0b9c3529a7b7f92436e2518733f38:"
        },
