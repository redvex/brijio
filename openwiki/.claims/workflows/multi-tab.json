    {
      "id": "claim_b810f0c66b104a03afef874993a7fc22",
      "statement": "`open_tab` exists to let the agent open a reference or auth page without disrupting the user's current tab, closing the gap between `navigate_to_url` (which destroys current page state) and `fetch_resource` (which returns raw HTML without rendering); `close_tab` and tab ownership tracking are deferred to P2.5.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0063-open-tab-action.md",
          "version": "repo-file-v1:sha256:db79ee600db5a83e31a9fb764b37418f9face30de9f3965f9c9c6b6ca3795252"
        }
      ]
    },
    {
      "id": "claim_9a364388f90a42569011aa0ab3a05cb1",
      "statement": "After navigating a targeted tab with `navigate_to_url` or `open_tab`, the agent must call `read_current_page` on that tab to get fresh element IDs, because element IDs are short-lived and expire when the page changes.",
