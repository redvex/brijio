    {
      "id": "claim_8ce343c5b35e46bd90c9a5685fe7ec6a",
      "statement": "open_tab creates a new tab via tabs.create({ url }) and returns { tabId, url, title } so the agent can target the new tab with subsequent reads/actions. It intentionally does not accept a tabId input (it creates a tab, not targets one), rejects non-HTTP(S) URLs with unsupported_scheme, surfaces tabs.create failures as open_tab_failed, and returns not_supported when the pageOpenTab adapter is not configured. It does not wait for the page to load; the agent must read_current_page to verify.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/background.ts#L498-L524",
          "version": "repo-lines-v1:sha256:8b097371d6548347155ce6144329b599aa2b5ce46f022f6534243c05ad2de90b:"
