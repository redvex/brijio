  "claims": [
    {
      "id": "claim_9054b0d0b7f7426785ba93d6147ee6e2",
      "statement": "Tab targeting is per-call and stateless: every tab-operating MCP tool takes an optional `tabId` (a non-empty string; empty strings are rejected with `invalid_tool_input`), it rides on the envelope's `target.tabId`, and when omitted the system falls back to the active tab in the current window with no hidden selected-tab session state.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md",
          "version": "repo-file-v1:sha256:b3ad39adb1eb175e95471f9aa0056c1c1315fa165193725881239733d483e3e8"
        },
        {
          "resource": "repo://servers/mcp/src/mcp-server.ts#L53-L62",
          "version": "repo-lines-v1:sha256:36fd0a02b43716b7d324ea2ccb62a4a3a52650011c5ac667b9026af892b5b0d7:"
        },
        {
