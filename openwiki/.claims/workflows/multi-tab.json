    {
      "id": "claim_0e7be0384c0d414a8812d769154c2fb9",
      "statement": "open_tab opens a new browser tab at an HTTP/HTTPS URL and returns the new tabId (plus url and title); it does not accept a tabId. It is stateless with no ownership tracking or close_tab. The response returns immediately after tabs.create resolves without waiting for the page to fully load, so the agent must read_current_page on the new tab to verify it loaded.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0063-open-tab-action.md#L324-L329",
          "version": "repo-lines-v1:sha256:afbca3045514b59f149579455eccd639b0e24678d4791c6ccbc8d00b366f28c0:"
