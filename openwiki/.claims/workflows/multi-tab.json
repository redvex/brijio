    {
      "id": "claim_55a0eb8346654785be73c6f1aac1ab02",
      "statement": "When the agent targets a non-active tab, the extension shows a tab indicator following the approval-banner injection pattern: a content-script title prefix (● U+25CF prepended to document.title, re-applied by a MutationObserver if the page changes its title) plus a persistent blue (#1a56db) in-page banner with role=status/aria-live=polite. show_brijio_tab_indicator and hide_brijio_tab_indicator messages swap the indicator as the agent switches tabs; banner injection may fail gracefully on restricted pages while the action still executes. open_tab needs no extra indicator beyond the standard one that appears on subsequent targeting.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0060-explicit-tab-listing-and-selection.md#L160-L226",
          "version": "repo-lines-v1:sha256:298c3c7e3948672ad938e3a73b1e0b8e942edb458ae60f5460f3c4f5b5de6381:"
        },
