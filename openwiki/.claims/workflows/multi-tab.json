          "version": "repo-lines-v1:sha256:c1ade8916c1133b554e695f73dfe51adcb1801e4d2f7a2a63664722850062988:"
        },
        {
          "resource": "repo://servers/mcp/src/page-actions.ts#L285-L340",
          "version": "repo-lines-v1:sha256:e5b81dd86f1e213016c6789a2012ba3fc8ff5cd6312654c95280533fd39d66e6:"
        }
      ]
    },
    {
      "id": "claim_9465917ff87b41eda912afea2b95e1fb",
      "statement": "Short-lived element IDs expire on any page change; the `using-brijio` skill encodes the read-before-act discipline (read the relevant skill before acting, re-read after navigation/DOM update, re-read and retry on `stale_context`/`page_navigated`/`data.aborted`), and the `navigation` skill documents the re-read-after-navigation rule for both click-through and direct URL navigation.",
