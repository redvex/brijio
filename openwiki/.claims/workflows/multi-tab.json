        }
      ]
    },
    {
      "id": "claim_4089b2bb4da34d2dbeeece8ae8d73cfe",
      "statement": "The `open_tab` tool opens a new tab at an HTTP(S) URL and returns the new tab's `tabId` (plus `url` and `title`); it does not accept a `tabId` itself. URL validation rejects non-HTTP(S) schemes with `unsupported_scheme` and invalid URLs with `invalid_tool_input`; the extension creates the tab via `chrome.tabs.create({ url })` / `browser.tabs.create({ url })` and the response returns immediately without waiting for the page to load (title may be empty).",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/background.ts#L519-L544",
          "version": "repo-lines-v1:sha256:74443d7a6cbe0f4eb00c305a2c0324217c87288b1f272ece3cd78b8ae689aa4c:"
        },
        {
