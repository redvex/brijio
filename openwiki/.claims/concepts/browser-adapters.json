    {
      "id": "claim_378e180bcab34c4aae1279f9a7140ac7",
      "statement": "ADR 0052 adds Safari reconnect-on-wake: the background entry persists desiredConnectionState (connected/disconnected) and reconnects on startup if the user previously requested a connected bridge with usable settings; the Safari content script sends brijio_page_active on pageshow, focus, and visibilitychange to give the background another reconnect chance. This is best-effort and only fires when Safari wakes the extension.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/safari/src/background-entry.ts#L260-L340",
          "version": "repo-lines-v1:sha256:e8a8438a40087b7190921ada05948e15a99bd8ec811aaa4cbc058ae403304535:"
