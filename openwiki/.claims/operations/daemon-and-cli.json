    {
      "id": "claim_ee926b596b7c453e937dde4bc2ada31e",
      "statement": "Daemon install/lifecycle is split by platform: macOS uses a LaunchAgent plist (RunAtLoad/KeepAlive true, WorkingDirectory ~/.brijio) linked into ~/Library/LaunchAgents and driven by launchctl load/unload; Linux uses a systemd user unit (Restart=on-failure, EnvironmentFile ~/.brijio/.env) linked into ~/.config/systemd/user and driven by systemctl --user. normalizePlatform supports only darwin and linux and throws for any other platform.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/daemon.ts#L240-L320",
          "version": "repo-lines-v1:sha256:07faff700a91d4d3de957d1134904334659ee804dd97e5cbb0b1e30f39397e82:"
