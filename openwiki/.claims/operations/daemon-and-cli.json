  "claims": [
    {
      "id": "claim_58e15080f49648bc96b4d4b882cba36f",
      "statement": "The brijio binary parses argv via parseDaemonCommand into a discriminated DaemonCommand union; top-level flags (--help, --print-config [agent], --doctor, --dev, --version) are handled before subcommands, recognized subcommands (install/uninstall/start/stop/restart/status/logs/demo/help) dispatch to daemon operations, and any other args fall through to run mode forwarded as server args.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/bin/brijio.mjs#L130-L200",
          "version": "repo-lines-v1:sha256:38f365b9b71b11b3943005ef773f6ff6927307169b9de3e845702b646f4ec8c5:"
        },
        {
          "resource": "repo://servers/mcp/src/daemon.ts#L92-L160",
          "version": "repo-lines-v1:sha256:52e9174eac3e25b97037c05e32a905aee169ea1c1e83dc786fb29fce4781d742:"
        }
      ]
    },
    {
      "id": "claim_fc6fde0e94594ff4950d2e7c9b0cbe36",
      "statement": "Server modules are imported dynamically only in run/demo mode; --doctor and --print-config exit before importing the server stack, so they never trigger the full module cascade and cannot fail on missing server dependencies.",
