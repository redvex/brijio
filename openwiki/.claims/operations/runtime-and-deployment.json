    {
      "id": "claim_7d9ea61bf25d452b99d76b8f76d3527e",
      "statement": "ADR 0049 unified releases on a single vX.Y.Z tag. The tag-and-release.yml workflow (on push to main / workflow_dispatch) reads the root package version, skips if the tag already exists (git ls-remote), otherwise builds/tests, extracts the matching CHANGELOG.md section (failing if absent), creates and pushes the annotated tag, and creates the GitHub Release. It superseded the older ext-chrome-v*/ext-safari-v* extension tags.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/tag-and-release.yml#L1-L120",
          "version": "repo-lines-v1:sha256:a7d451964c2859f1337059cecc2f8d9cfad78da51a967fd446b6bbc8cc559891:"
        },
        {
          "resource": "repo://docs/architecture/decisions/0049-unified-release-tag-and-assets.md",
          "version": "repo-file-v1:sha256:b28ceedcd2adc5ebc55bc11fd7f4e46aa9b26e7bf6ae60ea608136d46804b39c"
        }
