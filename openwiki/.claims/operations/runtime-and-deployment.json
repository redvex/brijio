    {
      "id": "claim_e3d52de22ccb4b538211cd73f41cf4b8",
      "statement": "MCP_HTTP_ALLOWED_ORIGINS is a comma-separated CORS origin allow-list. Entries beginning with *. are treated as hostname suffix wildcards (e.g. *.ts.net matches device.tailnet.ts.net, *.local matches browserbridge.local), implemented by isAllowedOrigin/matchesWildcardHost. This is a routing guardrail, not authentication: the MCP_HTTP_AUTH_TOKEN bearer token remains required before MCP tool handling.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0025-tailscale-friendly-mcp-http-hosts.md",
          "version": "repo-file-v1:sha256:af0b0e71b8c2500a527c621d98197739ef22e6b2902ee1d4bb846992908c9188"
        },
        {
