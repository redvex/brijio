    {
      "id": "claim_b6f9f2598b83431bb138eafc854e61c7",
      "statement": "`pnpm dev` runs `node scripts/dev.mjs`, an orchestrator that auto-generates BRIJIO_PAIRING_TOKEN and MCP_HTTP_AUTH_TOKEN from a fresh .env, spawns the WS and MCP servers with tsx watch, polls GET /health before declaring readiness (500ms interval, 15s timeout), supervises with crash restart (2s backoff, max 5), and propagates SIGINT/SIGTERM to children within a 5s grace window.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0029-one-command-startup.md#L1-L60",
