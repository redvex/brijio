    {
      "id": "claim_fc2baad4cd4e4bb0b35e4c3b89dd8888",
      "statement": "Chrome (clients/extensions/chrome) is the first implementation using the chrome.* namespace with an MV3 service worker and imports BrijioBackgroundController, createGlobalTimers, normalizeBridgeSettings, and adapter types from @brijio/shared; Safari (clients/extensions/safari) is a parallel implementation contributing only thin browser.* adapters (background.ts, background-entry.ts, content-script-entry.ts, popup.ts, popup-entry.ts, permissions.ts) while shared behavior stays in packages/shared; both follow the same product rules of user-controlled activation, explicit request/response, no continuous streaming, page context before content, and short-lived action IDs.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/README.md#L1-L88",
