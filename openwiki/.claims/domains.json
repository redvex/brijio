    {
      "id": "claim_e86debc52d2743e68dd6aee6fb82f819",
      "statement": "The WebSocket relay (servers/websocket) authenticates clients with the local pairing token, maintains a per-scope in-memory presence table, and routes messages between the MCP server and extensions; it is state-light — presence is runtime-only and deleted from the map when the socket closes. It re-exports canonical envelope helpers from @brijio/shared and only adds createScopeKey (a SHA-256 hash of the token).",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/protocol.ts",
          "version": "repo-file-v1:sha256:00b3c794d41dc765680393e2e0f95bc1a9baf356fffdecb56c2ed2e0a206843d"
        },
        {
