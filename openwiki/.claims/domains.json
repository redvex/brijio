    {
      "id": "claim_2fca7ad28458483394b3a61cc5246260",
      "statement": "Chrome is the first extension implementation using Manifest V3 (service-worker background, activeTab/scripting/storage/tabs/downloads permissions, broad host_permissions), while Safari is a parallel implementation (ADR 0019) using the browser.* namespace, an MV2 background script with platform-specific persistence, a text-only ON/OFF/ERR badge because Safari's browser_action does not support badge color, broad host access granted at install time rather than via runtime optional_host_permissions prompts, and a popup overlay instead of a Chrome-style setup page.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/manifest.json#L1-L40",
          "version": "repo-lines-v1:sha256:a389ff181dadd0ff46f415bba4054e6e60bbcd0615d4a3d2f6e8bef78b937ca4:"
