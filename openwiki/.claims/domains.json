    {
      "id": "claim_f9c90a6894514a5cad7fce871a4d6536",
      "statement": "The WebSocket relay authenticates MCP and extension clients against the local pairing token set, derives a sha256 scope key from the accepted token, tracks browser presence per scope in an in-memory map that is cleared when the socket closes (no page URL, title, content, or DOM state), answers list_browsers directly from presence, and forwards other MCP requests to the targeted extension socket by target.browserInstanceId, requiring an explicit ID when more than one browser is online.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/README.md#L5-L24",
          "version": "repo-lines-v1:sha256:550484ae5bb5176073580c295ff274907c700e2d6718b3a54428401d4ebb7262:"
