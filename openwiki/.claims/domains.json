    {
      "id": "claim_74e56c85c9bc483cabad05e721ea1dab",
      "statement": "Both extensions share the same product rules: user-controlled activation (connect only after explicit user action), explicit request/response behavior with no continuous page streaming, page context before page content (progressive disclosure), and action targeting through short-lived IDs scoped by target.kind. Continuous streaming, browser mirroring, cookie export, session cloning, and credential extraction are explicit non-goals.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/README.md#L7-L49",
          "version": "repo-lines-v1:sha256:cd1faf2aaca15475e55df1dda57b921dbd94f17fcaa75f40c542c4af65161449:"
