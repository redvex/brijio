    {
      "id": "claim_727a214bb193425ca2bc86a8f330bf97",
      "statement": "AGENTS.md prescribes the smallest verification set per domain: pnpm --filter @brijio/<pkg> test and check for shared, websocket, mcp, chrome-extension, and safari-extension; pnpm test and pnpm check for cross-package changes; and pnpm lint, pnpm build, pnpm test to match CI before a PR.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L158-L185",
          "version": "repo-lines-v1:sha256:bb420092a52066c140c7d46dd6bb2afeb9901ac01c6b26595ea226bc4f63da86:"
        }
      ]
    },
    {
      "id": "claim_beaabed8ea4847dda17f778405fc2718",
      "statement": "AGENTS.md requires an ADR before implementation for changes to product capability/behavior, cross-package protocol/schema, architectural boundaries, auth/privacy/storage/trust boundaries, browser routing/targeting/lifecycle, or materially new dependencies; ADRs are numbered with the next unused number, start Proposed, become Accepted only after explicit user approval, and are usually not required for bug fixes, tests, doc-only corrections, behavior-preserving refactors, or narrow tooling maintenance.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L62-L98",
          "version": "repo-lines-v1:sha256:34f342b770571aa802efe7656399a8ff24bc01fcba71882a568907a9dd3acd77:"
        }
      ]
    },
    {
      "id": "claim_7e13b44a279340f683c606afd66ef2ab",
      "statement": "AGENTS.md assigns ownership boundaries (shared protocol in packages/shared, relay in servers/websocket, agent-facing tools/resources/skills in servers/mcp, browser-specific integration in the extension packages) and requires preserving explicit per-call browser and tabId targeting with no hidden selected-tab session state, keeping the active-tab fallback when tabId is absent, and re-reading page context after navigation or mutations that invalidate short-lived target IDs.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L113-L142",
          "version": "repo-lines-v1:sha256:542df33fcb8406891447587bb09533e39d45f05a930ac7eea52a8f6a0e0728a1:"
