  "claims": [
    {
      "id": "claim_84b46a971c6d4c809e1fac71535a334f",
      "statement": "Page content extraction and page actions run in the browser tab context inside an injected content script, not in the extension background service worker; the background adapter (page-reader.ts) only targets a tab, injects the script, and relays messages.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/content-script-entry.ts#L346-L418",
          "version": "repo-lines-v1:sha256:d9ce259ebef529cf8a2954f0deaca225814c169dcb77b920c4e6582569cdf2f7:"
        },
        {
          "resource": "repo://packages/shared/src/page-reader.ts#L155-L185",
          "version": "repo-lines-v1:sha256:07f7581d7dd015cf1a56ae2f019bc083c6c75fa7e6c31f025123d5e1990c3c4e:"
        }
      ]
    },
    {
      "id": "claim_567091f03992444bba4472fbbf7f8847",
      "statement": "Content extraction is layered across four @brijio/shared modules: content-handler.ts dispatches ContentRequest to operations, page-context.ts builds the PageContext (accessibility structure, visible-context id, preview), page-content.ts byte-bounds content into chunks, and page-reader.ts is the background-side adapter that injects and messages the content script.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/content-handler.ts#L152-L242",
          "version": "repo-lines-v1:sha256:6a70756751b68c3147ff791897a3a2c606367785363fd2991383685b9c0247b7:"
        },
        {
