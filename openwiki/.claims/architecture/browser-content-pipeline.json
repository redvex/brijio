    {
      "id": "claim_f40c15a36b8348998888a5df6423ccfc",
      "statement": "handleContentRequest maps failures to structured error codes: invalid_index for an out-of-range chunk index, extraction_failed for unexpected extraction errors, page_navigated and stale_context for context guards, and target_not_found/target_disabled/action_failed for action-level failures.",
