    {
      "id": "claim_36aafc7f31764292aef4fc129098d479",
      "statement": "A page read is two-stage: extract_page_context returns a PageContext with the accessibility structure (headings, landmarks, links, images, forms, editables, actions with positional bb-N ids), a byte-bounded preview chunk, and a content capability advertisement (requestType get_page_content, firstIndex 1); the agent then fetches full content via extract_page_content using a 1-based index.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/content-handler.ts#L152-L180",
          "version": "repo-lines-v1:sha256:2088d8105f5a90c0a1f0d104a089fbdb33d557871ad7a17592996ce457a40409:"
