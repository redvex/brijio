    {
      "id": "claim_6bf3791fa89545a0a8437b6781310a77",
      "statement": "On the background side, readActiveTabPage and performActiveTabAction normalize content-script responses into PageReadResult/PageActionResult envelopes; a missing response or a timeout (default 4000ms via contentScriptMessageTimeoutMs) becomes content_script_unavailable, and a failed permission check becomes regular_page_permission_required.",
