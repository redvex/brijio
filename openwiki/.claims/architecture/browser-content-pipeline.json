    {
      "id": "claim_a761ccaaa965446dbed3cacf4997746e",
      "statement": "registerPageNavigationListener increments a module-scoped pageContextVersion on every pageshow event (navigation/bfcache restore) and replaces the previous injection's pageshow listener via globalThis.__brijioPageShowListener so the counter increments once per navigation rather than once per re-injection.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/decisions/0043-idempotent-content-script-injection.md#L18-L26",
          "version": "repo-lines-v1:sha256:77076995079ade851d93dfe250907b56599722e3efc5f9c9f70c23084e06b1db:"
