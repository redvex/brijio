    {
      "id": "claim_607bec5f5c9f411e81c9186b835c9be4",
      "statement": "Action requests may carry a pageContextId echoed from the last read; if it does not match the current pageContextVersion, handleContentRequest returns a page_navigated error with previousContextId/currentContextId telling the agent to re-read.",
