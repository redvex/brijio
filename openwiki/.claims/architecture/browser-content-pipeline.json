    },
    {
      "id": "claim_bcd947aaffde488b9d40622b7c8843e5",
      "statement": "chunkReadableContent paginates readable content by byte budget (measured with TextEncoder), splitting on blank-line block boundaries first and falling back to character-by-character splitting for oversized blocks; it throws invalid_index for an out-of-range 1-based index, and returns truncated true when more chunks follow.",
      "evidence": [
