        }
      ]
    },
    {
      "id": "claim_1da066bca6374b0b88c372f1afcf50f6",
      "statement": "selectBrowser returns browser_unavailable when no browser is online, ambiguous_browser_target when more than one is online and no browserInstanceId is specified, and matches the explicit browserInstanceId otherwise; these error envelopes are sent directly to the MCP socket without forwarding.",
