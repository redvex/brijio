    {
      "id": "claim_19ed9bdeac83485bb8cde5c5862f9695",
      "statement": "An MCP tool call travels Agent -> MCP Server -> WebSocket Relay -> Extension Background -> Shared Controller -> Browser Tab, with the response retracing that path; the MCP websocket-client authenticates and stamps a target envelope, the relay routes by scopeKey and browserInstanceId and matches replies by pendingRequestKey(scopeKey, requestId), and the shared controller dispatches to adapters that perform tab work.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L543-L620",
          "version": "repo-lines-v1:sha256:f073f2358ca8e712531259a910557d341c4c29bafd1c2d869fdf7fcee1fa2007:"
        },
        {
