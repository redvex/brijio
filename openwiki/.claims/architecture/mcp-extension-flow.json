        }
      ]
    },
    {
      "id": "claim_7b65b9d6a3cf4f25b4f6a8f7542a6512",
      "statement": "The WebSocket relay resolves the target extension socket via selectBrowser (preferring target.browserInstanceId, else requiring exactly one online browser), records the pending MCP socket under scopeKey:message.id, and forwards the entire envelope unchanged so target.tabId is preserved; extension responses are routed back by that pending-request key.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L278-L298",
          "version": "repo-lines-v1:sha256:5888144b66fc28dfe03c6154adf290ffbe3ab1baee23a190f5ddea079fd4cc50:"
