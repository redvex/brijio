    {
      "id": "claim_ba5ec49b3978468c8e6142b1c29c15a1",
      "statement": "Every MCP tool call follows a six-hop path: agent calls MCP tool -> mcp-server.ts handler delegates to a per-tool function -> page-actions.ts/page-context.ts call websocket-client.ts requestBrijio which authenticates and sends an envelope with target.browserInstanceId/tabId -> the WS relay selects a browser from presence and forwards the envelope unchanged to the extension socket -> BrijioBackgroundController.handleSocketMessage dispatches by payload type to handlers/adapters -> the response is routed back by message.id through the relay to the waiting MCP socket and parsed back to the agent.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L555-L721",
          "version": "repo-lines-v1:sha256:87f7b0af7d953bd9722145266accaa94b6ab81119e7cadcb96a072bd228e9892:"
        },
