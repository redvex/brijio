    {
      "id": "claim_e25574edb44448deb92231fe28c09920",
      "statement": "requestBrijio opens a fresh WebSocket per tool call, authenticates with the pairing token (SHA-256 scope key), sends the request envelope with a target block, resolves exactly once on success/router error/timeout/socket close, then closes the socket. targetEnvelope only adds target when browserInstanceId or tabId is present.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts#L698-L805",
          "version": "repo-lines-v1:sha256:e5a00514f2c2d0d97e8f3402961dec60d76bb450d1f8778de971e648da4f9196:"
