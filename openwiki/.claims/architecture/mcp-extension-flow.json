    {
      "id": "claim_8a6d733c8658448f9ec738bcda232574",
      "statement": "The MCP server opens a fresh WebSocket per tool call: websocket-client.ts authenticates with a pairing token, waits for auth_success, then sends a request envelope whose target field carries optional browserInstanceId and tabId; the relay selects a connected browser session from its presence table and forwards the envelope verbatim to that extension socket after recording the pending request keyed by scope and request id.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts#L698-L838",
          "version": "repo-lines-v1:sha256:fe4fa89eedf3446e83bbb31b982d7e75bd6a13a6a2865a25bbe0aa3545721037:"
        },
        {
