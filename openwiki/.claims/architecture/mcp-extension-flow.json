    {
      "id": "claim_ed59ef9d7d6b492ca983bd2d8a1dca57",
      "statement": "The end-to-end MCP to extension request path is owned by a fixed set of modules in order: mcp-server.ts registers tools and delegates to per-tool files; tool files normalize input and call page-actions.ts/page-context.ts; those call websocket-client.ts which builds the envelope with target.browserInstanceId and target.tabId, authenticates, and sends to the relay; the relay forwards unchanged to the selected extension socket; BrijioBackgroundController dispatches by payload type to adapters; shared page-reader.ts resolves the tab and exchanges messages with the content script; responses return by matching requestId.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/background-controller.ts#L560-L660",
