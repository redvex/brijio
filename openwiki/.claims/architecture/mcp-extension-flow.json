    {
      "id": "claim_f4aedd2b56b148b1b01f7655dd2bc0ce",
      "statement": "The WebSocket relay forwards the full MCP request envelope to the selected extension unchanged, preserving the envelope target (including tabId and browserInstanceId); the only MCP request the relay answers itself is list_browsers, which it resolves directly from its in-memory presence table. Extension responses with a matching id are routed back to the pending MCP socket via a scopeKey:requestId key; on socket close pending entries for that socket are removed.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L286-L306",
