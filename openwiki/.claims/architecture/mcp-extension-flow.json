    {
      "id": "claim_e6034c0c9c27482992317d7a97686dd4",
      "statement": "requestBrijio opens a fresh WebSocket per call, authenticates with the pairing token, and on auth success sends targetEnvelope(options), which injects a target field { browserInstanceId?, tabId? } onto the request envelope only when either value is present; the call is bounded by a timeout and maps router errors, auth failures, timeouts, and connection failures to typed results.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts#L698-L838",
          "version": "repo-lines-v1:sha256:fe4fa89eedf3446e83bbb31b982d7e75bd6a13a6a2865a25bbe0aa3545721037:"
        }
      ]
    },
    {
      "id": "claim_6cd3bfbb6cb94fa4a7ecefd4899e0453",
      "statement": "The WebSocket relay authenticates connections by pairing token, scopes them by a hash-derived scopeKey, tracks browser presence, answers list_browsers from its presence table, and for every other request selects the extension by message.target.browserInstanceId (or the single online browser) then records a pending request keyed by scopeKey:message.id and forwards the full message including target unchanged to the selected extension; extension responses are routed back by that key.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L164-L306",
          "version": "repo-lines-v1:sha256:f844b60ebf624e7dd925659367acbdede22fec846e36570cadf4970f9481f0b4:"
