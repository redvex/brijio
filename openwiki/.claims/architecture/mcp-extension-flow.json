    {
      "id": "claim_dd4bcac8fdb14ba3941b9534aa4c99c3",
      "statement": "The relay does not interpret tool payloads except list_browsers (answered from presence). It selects a browser scoped to the same pairing token, matching target.browserInstanceId when present, returning browser_unavailable or ambiguous_browser_target otherwise, keys pending requests by scopeKey:requestId, forwards the envelope to the extension socket, and routes the matching response back to the requesting MCP socket.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L286-L306",
          "version": "repo-lines-v1:sha256:d7900d465cca3d3e97d11d606546dc139dd294dcb9dcb4317507ac054a3f6d7b:"
