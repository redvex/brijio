          "version": "repo-lines-v1:sha256:2051b780ecf18d897ba01f4f803dfecd6a4af26e07ce9d210a45c3f36da30939:"
        }
      ]
    },
    {
      "id": "claim_54db7de0fabf46bdbd5a1f03fcdae639",
      "statement": "The WebSocket relay correlates responses back to the requesting MCP socket by matching scopeKey:requestId in routeExtensionResponse, deleting the pending entry and forwarding the extension's response envelope; on socket close it cleans up both presence and pending-request entries so in-flight MCP calls fail rather than hang.",
      "evidence": [
