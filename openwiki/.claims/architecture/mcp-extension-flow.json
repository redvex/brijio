    {
      "id": "claim_6ff5207f7f7c4c67814ca5a0e45c1e0b",
      "statement": "perform_batch is approval-aware: when any action is approval-gated it routes through performApprovalAwareBatch which checks each action's approval in order. approval_timeout aborts the batch and marks remaining actions as skipped/timeout; other approval failures become per-action errors and the batch continues only when continueOnError is true. requestBrijio uses approvalTimeoutMs (falling back to timeoutMs) for gated requests so the approval window can elapse before the MCP HTTP timeout.",
      "evidence": [
