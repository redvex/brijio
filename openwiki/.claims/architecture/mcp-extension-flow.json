    {
      "id": "claim_ef5ab92b76bb498ca627401d7018a02f",
      "statement": "Per-call tabId is threaded end to end: MCP tool modules normalize input.tabId and pass it to page-actions.ts/page-context.ts; websocket-client.ts targetEnvelope places tabId in envelope.target.tabId as a string when present; BrijioBackgroundController.handleSocketMessage calls extractTabId to read message.target.tabId and parse it to a number, then forwards it to the matching handler; the shared page-reader.ts helpers and the Chrome/Safari navigation adapters use the numeric tabId directly when provided and otherwise fall back to querying the active foreground tab.",
      "evidence": [
        {
          "resource": "repo://clients/extensions/chrome/src/background.ts#L675-L697",
