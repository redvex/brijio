    {
      "id": "claim_1374214937fc4ae2bf259f7b0d0a94f3",
      "statement": "Each MCP tool call maps to one requestBrijio invocation that opens a fresh WebSocket, sends an auth envelope with role mcp, waits for auth_success, sends the targeted request envelope, then settles exactly once on a parsed result, router error, timeout, socket error, or unexpected close; settle is idempotent and closes the socket.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts#L698-L805",
          "version": "repo-lines-v1:sha256:e5a00514f2c2d0d97e8f3402961dec60d76bb450d1f8778de971e648da4f9196:"
        }
      ]
    },
    {
      "id": "claim_8572c1ad3f8e4a408b780001d20b0040",
      "statement": "targetEnvelope() only adds a target object (browserInstanceId and/or tabId) to the request envelope when at least one is defined, leaving the envelope unchanged when both are absent; the relay forwards the full envelope unchanged so the extension receives target.tabId.",
