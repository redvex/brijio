        }
      ]
    },
    {
      "id": "claim_039d16c0abcd4b5dbe7caf469bd268c1",
      "statement": "tabId is threaded as a string through the MCP tool input schema and envelope target, then parsed to a number at the extension boundary by extractTabId reading message.target.tabId; page-reader helpers use the provided numeric tabId directly and fall back to the active-tab lookup only when tabId is undefined, keeping older callers backward compatible.",
