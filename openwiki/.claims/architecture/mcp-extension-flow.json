          "version": "repo-lines-v1:sha256:584c6fa2a54d67948812b165882d4e2d31eb2c4152510d05645eb3941f80ef6c:"
        }
      ]
    },
    {
      "id": "claim_d7bd95b1504349d6bef1cff3a385e5d5",
      "statement": "BrijioBackgroundController.handleSocketMessage parses each inbound relay message and calls extractTabId to read message.target.tabId into a number, then dispatches by payload type and threads the numeric tabId into the page-reader, action, batch, and navigation handler methods and their adapter calls.",
