    {
      "id": "claim_af5d7b7219914f3fbe2f961f8852ffb7",
      "statement": "The WebSocket relay is a stateless forwarder: it authenticates peers by pairing token, derives a scopeKey so an MCP peer and its extension peers form one routing scope, selects a browser by message.target.browserInstanceId, records the MCP socket under pendingRequestKey(scopeKey, requestId), forwards the entire envelope unchanged to the extension, and routes the extension response back by matching requestId to the pending socket. It never inspects target.tabId.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/protocol.ts#L8-L24",
          "version": "repo-lines-v1:sha256:04607f4d08bd50eb40fd37af6a46199d21b4b9520eb1d69a8f26cd32a28b6505:"
        },
        {
