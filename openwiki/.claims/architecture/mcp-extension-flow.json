        }
      ]
    },
    {
      "id": "claim_080755f8cfb54a339cfdb691a7a0fc61",
      "statement": "The WebSocket server authenticates connections by role, keeps a presence table keyed by scopeKey:browserInstanceId, answers list_browsers directly, and forwards all other MCP messages to the selected extension socket via selectBrowser; pending requests are keyed by scopeKey:requestId and extension responses are routed back to the originating MCP socket.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L286-L306",
          "version": "repo-lines-v1:sha256:d7900d465cca3d3e97d11d606546dc139dd294dcb9dcb4317507ac054a3f6d7b:"
