    {
      "id": "claim_9db10fe1aa324a28b6ba4ef7a4b66574",
      "statement": "browserInstanceId selects which connected browser the relay forwards to (matched against the presence table, requiring exactly one when omitted), while tabId selects which tab within that browser; the relay performs browser selection and the extension performs tab selection.",
