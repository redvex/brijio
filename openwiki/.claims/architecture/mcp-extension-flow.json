    {
      "id": "claim_dad695946a4b472aa6342d407740b5b8",
      "statement": "The WebSocket relay authenticates the pairing token, derives a scopeKey via SHA-256, stores per-scopeKey browser presence, selects a browser for an MCP request using message.target.browserInstanceId (returning browser_unavailable or ambiguous_browser_target when missing/ambiguous), records the MCP socket under pendingRequestKey(scopeKey, message.id), and forwards the envelope unchanged to the extension socket; extension replies are routed back by that key and cleaned up on socket close.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/protocol.ts#L17-L18",
          "version": "repo-lines-v1:sha256:dd50dd64459d680fe6a796a75b5c95e1d030c686f66325c868855538cc46c2a9:"
