    {
      "id": "claim_c9daee1797cd4e159b8dad1342354de4",
      "statement": "The WS client applies error forwarding before tool-specific parsing: on every incoming message it runs parseRouterErrorEnvelope first and short-circuits (settles) when the relay returns an error, so a router-level error reaches the agent with the relay's real code and message; only when parseRouterErrorEnvelope returns ignored does it proceed to auth handling or the tool-specific parseEnvelope.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts#L741-L777",
          "version": "repo-lines-v1:sha256:c16e1a383472e5adbd95215b0a94555503958877f42473d05902be72a9888016:"
        }
      ]
    },
