    {
      "id": "claim_eaafdac1c687479a842335fd8a6b64be",
      "statement": "The MCP websocket client opens a fresh WebSocket per request, authenticates with createAuthEnvelope, and on auth_success sends the request envelope wrapped by targetEnvelope which merges browserInstanceId and tabId into envelope.target when present.",
      "evidence": [
        {
          "resource": "repo://servers/mcp/src/websocket-client.ts#L744-L770",
          "version": "repo-lines-v1:sha256:b8a2a87e1808ae263280b8f5fef2784cd270f26130e3eca4a20525a064c3a2cf:"
