        }
      ]
    },
    {
      "id": "claim_b674b2f7f732497f84c57befeab04aa2",
      "statement": "Connections start unauthenticated; the first message must be an auth payload or the relay replies auth_required, an invalid token replies auth_failed, and on success the relay sets role and scopeKey, replies auth_success, and (for extension role) immediately sends a browser_presence_request.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L170-L202",
          "version": "repo-lines-v1:sha256:c44f75d216bcd0f469fbec7a64803d4c5ae95518e881a090e1ae2b3d58d62eaa:"
        }
      ]
    },
    {
      "id": "claim_89ac79697d2e4d1aac1bd3521f395e56",
      "statement": "The relay recognizes two roles only (extension and mcp): extensions announce presence, send keepalives, and return responses to pending requests; mcp connections list browsers and send requests to be forwarded to an extension.",
