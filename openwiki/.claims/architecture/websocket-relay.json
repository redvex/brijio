          "version": "repo-lines-v1:sha256:82f4522d1e88b7ca90edd57f65affa21a258d6df692c42a4e6a3916949c3e45f:"
        }
      ]
    },
    {
      "id": "claim_3ec1f7787fc440b9bf556ac8621e6d49",
      "statement": "When forwarding an MCP request with an id, the relay records the originating MCP socket in pendingRequests keyed by scopeKey+message.id and forwards the envelope unchanged to the extension; the extension's later message with a matching id is routed back to that MCP socket and the pending entry deleted. Requests without an id are forwarded but cannot receive a routed response.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L277-L304",
          "version": "repo-lines-v1:sha256:71ce8e3614c169c3f5790eb304aaa1b0e4dde7196dfebb42e24dc4e7bb15a5b2:"
        },
        {
          "resource": "repo://servers/websocket/src/server.ts#L357-L377",
          "version": "repo-lines-v1:sha256:ca098c24ee1b271508b8902ba2fbbba4c2ab0f5c5c2ea5f6ea7961c4d9e06444:"
        }
      ]
    },
    {
      "id": "claim_d5a4101897ce4f199192ec2e4611a0b5",
      "statement": "On socket close the relay deletes that connection's presence entry (if it had a scopeKey+browserInstanceId) and removes every pendingRequests entry whose originating socket was the closing one, so an MCP disconnect does not leak entries whose responses would never be read.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/server.ts#L154-L171",
          "version": "repo-lines-v1:sha256:0bd6f479d63c3d87589f0df5a1e361220738302e09d37af2acb3fca797b90726:"
        },
        {
