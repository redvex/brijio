          "version": "repo-lines-v1:sha256:25b0251ce3c23de8a514b9683503877b8e15345af4079bfc26a20d4514c26d60:"
        }
      ]
    },
    {
      "id": "claim_ba1caa909bf64b8999cd7f3bf22d35e2",
      "statement": "The HTTP server serves GET /health only (any other method/path returns 404) with a JSON object of status, version (from package.json), uptimeSeconds, and extensions (count plus a list of online browsers' browserInstanceId and label); getStatus is also exposed programmatically on the returned server object.",
      "evidence": [
