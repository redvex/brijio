    {
      "id": "claim_3a501353cff3402c88105aa0cceaaeb1",
      "statement": "The WebSocket relay authenticates connections with a pairing token (options.pairingToken, then BRIJIO_PAIRING_TOKEN, then BRIJIO_TOKEN) plus additionalPairingTokens, throws at startup if no token is configured, and derives a SHA-256 scope key from the token that isolates routing and presence per token.",
      "evidence": [
        {
          "resource": "repo://servers/websocket/src/protocol.ts#L15-L17",
          "version": "repo-lines-v1:sha256:5daf1de898a45d905f420b599d9dd804b696bed85ddffe44fee1db78a0169735:"
        },
        {
          "resource": "repo://servers/websocket/src/server.ts#L143-L156",
