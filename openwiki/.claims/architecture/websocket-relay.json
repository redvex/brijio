    {
      "id": "claim_0001bb39aa4f4fbaa1b1265df173d4f3",
      "statement": "extension_keepalive messages are silently accepted by the relay and neither forwarded to other clients nor answered with an error; they exist only to keep the Chrome MV3 background service worker alive while the bridge is ON and carry no page data.",
