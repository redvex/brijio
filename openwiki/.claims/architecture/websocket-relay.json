    },
    {
      "id": "claim_70c57c4b77094e2bb0d83b0e6569ec67",
      "statement": "The relay emits single-line JSON LogEntry objects to stderr via createLogger('websocket') from packages/shared, including events like server_started, client_authenticated, auth_failed, presence_announce, mcp_request_routed, and invalid_message, with scope keys truncated to 8 characters in log context so the raw token is never logged in full.",
